+        _sbu_failures=0
+        _sbu_backoff=10
+    else
+        _sbu_failures=$((_sbu_failures + 1))
+        if [ "$_sbu_failures" -gt 1 ] && [ "$_sbu_backoff" -lt 300 ]; then
+            _sbu_backoff=$((_sbu_backoff * 2))
