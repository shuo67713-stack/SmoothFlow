+supervisor_backoff_update() {
+    _sbu_runtime=$1; _sbu_failures=$2; _sbu_backoff=$3
+    case "$_sbu_runtime" in ''|*[!0-9]*) return 1 ;; esac
+    case "$_sbu_failures" in ''|*[!0-9]*) return 1 ;; esac
+    case "$_sbu_backoff" in ''|*[!0-9]*) return 1 ;; esac
