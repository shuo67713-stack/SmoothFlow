diff -ruN /tmp/sf_batch/orig/SmoothFlow_5.0.4/.github/workflows/test.yml /tmp/sf_batch/patch/SmoothFlow_5.0.4/.github/workflows/test.yml
--- /tmp/sf_batch/orig/SmoothFlow_5.0.4/.github/workflows/test.yml	2026-11-09 05:03:06.000000000 +0000
+++ /tmp/sf_batch/patch/SmoothFlow_5.0.4/.github/workflows/test.yml	2026-11-10 03:49:45.027714936 +0000
@@ -16,8 +16,10 @@
           set -euo pipefail
           for file in action.sh post-fs-data.sh service.sh uninstall.sh \
                       bin/core.sh bin/daemon.sh bin/supervisor.sh \
